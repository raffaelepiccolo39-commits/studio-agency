# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=your_token_here

# Email (Resend) — canale principale di tutti i moduli del sito
RESEND_API_KEY=your_resend_api_key
# Mittente delle email. Deve essere un indirizzo su un dominio verificato in
# Resend, altrimenti gli invii vengono rifiutati.
RESEND_FROM=Pira Web <info@piraweb.it>

# Gestionale — fa entrare i lead nel CRM.
# ⚠️ Deve coincidere con CONTACT_FORM_API_KEY sul gestionale: se le due chiavi
# non combaciano, il webhook risponde 401 e i lead NON entrano nel CRM, mentre
# l'utente vede comunque il messaggio di conferma. Senza questa variabile
# l'errore finisce nei log di Vercel: cercare "[contact] GESTIONALE_WEBHOOK_KEY".
GESTIONALE_WEBHOOK_KEY=your_webhook_key

# Site
NEXT_PUBLIC_SITE_URL=https://www.piraweb.it
